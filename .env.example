# ==============================================================================
# LAFUMIPP, LLC - Environment Configuration
# ==============================================================================

# Canonical Production Domain
NEXT_PUBLIC_SITE_URL=https://www.lafumipp.com

# Search Engine Indexing (Set to 'true' only when approved by client for production launch)
NEXT_PUBLIC_ALLOW_INDEXING=false

# Contact Form SMTP Email Settings
CONTACT_TO_EMAIL=info@lafumipp.com
CONTACT_FROM_EMAIL=info@lafumipp.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional Cloudflare Turnstile Spam Protection
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Optional Opt-In Telemetry (Disabled by default)
NEXT_PUBLIC_ENABLE_ANALYTICS=false
